import {performance} from 'node:perf_hooks';import {writeFileSync} from 'node:fs';
import {TownPopulation,DEFAULT_TOWN_TUNING} from '../src/town-population.ts';import {startingTown,TOWN_CENTER,TOWN_SPAWN} from '../src/starting-town.ts';import {generateRegionalChunk} from '../src/regional-world.ts';import {createTownView} from '../src/town-view.ts';
const seed=73129,p=new TownPopulation(seed),timings:number[]=[];for(let i=0;i<100;i++)p.update(i/60,TOWN_CENTER);for(let i=100;i<12100;i++){const a=performance.now();p.update(i/60,TOWN_CENTER);timings.push(performance.now()-a);}timings.sort((a,b)=>a-b);const chunks=[];for(let z=-1;z<=1;z++)for(let x=-1;x<=1;x++){const a=performance.now(),c=generateRegionalChunk(seed,Math.floor(TOWN_SPAWN.x/64)+x,Math.floor(TOWN_SPAWN.z/64)+z);chunks.push({key:c.key,ms:performance.now()-a,structures:c.structures.length,features:c.features.length,vertices:c.terrain.vertices.length/3});}
const view=createTownView(seed);const a=performance.now();view.update(200,TOWN_CENTER,()=>true,true,DEFAULT_TOWN_TUNING,true);const projectedMs=performance.now()-a;let triangles=0;for(const child of view.root.children){const mesh=child as any;triangles+=(mesh.geometry.index?.count??mesh.geometry.attributes.position.count)/3*mesh.count;}const result={kind:'axiom-starting-town-measurement',seed,scope:'Node22 CPU/geometry only; no GPU, browser render, frame-time, mobile or device-performance certification',roster:100,homes:startingTown(seed).homes.length,shops:startingTown(seed).shops.length,tuning:DEFAULT_TOWN_TUNING,samples:timings.length,updateMeanMs:timings.reduce((a,b)=>a+b,0)/timings.length,updateP95Ms:timings[Math.ceil(timings.length*.95)-1],updateP99Ms:timings[Math.ceil(timings.length*.99)-1],updateMaxMs:timings.at(-1),sampledResidentUpdates:p.updates,projectionMs:projectedMs,residentTriangles:triangles,render:view.stats,initialChunks:chunks,initialStructurePieces:chunks.reduce((n,c)=>n+c.structures,0),maxChunkStructurePieces:Math.max(...chunks.map(c=>c.structures))};view.dispose();const output=process.argv.find(a=>a.endsWith('.json'));if(output)writeFileSync(output,JSON.stringify(result,null,2)+'\n');console.log(JSON.stringify(result));
