import {performance}from'node:perf_hooks';import{writeFileSync}from'node:fs';import{createTownView}from'../src/town-view.ts';import{TownCrowd,TownPresentationClock,TownRenderMotion}from'../src/town-crowd.ts';import{TOWN_CENTER}from'../src/starting-town.ts';import{DEFAULT_TOWN_TUNING}from'../src/town-population.ts';
const cases=[];for(const population of [7,100])for(const [label,x,z]of [['square',0,0],['northwest',-35,-20],['northeast',35,-20],['southwest',-35,20],['southeast',35,20],['dormant',1000,1000]] as const){const v=createTownView(73129),observer={x:TOWN_CENTER.x+x,z:TOWN_CENTER.z+z},tuning={...DEFAULT_TOWN_TUNING,population},times:number[]=[];try{for(let n=0;n<160;n++){const start=performance.now();v.update(100+n/60,observer,()=>true,true,tuning,n===0,1/60,[{id:'test',...observer,feetY:6}]);if(n>=40)times.push(performance.now()-start);}times.sort((a,b)=>a-b);cases.push({label,population,samples:times.length,meanMs:times.reduce((a,b)=>a+b,0)/times.length,p95Ms:times[Math.ceil(times.length*.95)-1],p99Ms:times[Math.ceil(times.length*.99)-1],maxMs:times.at(-1),stats:v.stats});}finally{v.dispose();}}
const frames=[];for(const hz of[30,60,120]){const c=new TownCrowd(73129),m=new TownRenderMotion(),clock=new TownPresentationClock();let previous:{x:number;z:number}|undefined,zero=0,max=0,end;for(let n=0;n<=hz*2;n++){const t=clock.sample(100+Math.floor(n/hz*60+1e-8)/60,1/hz,n===0),p=m.update(c.sample(t),1/hz,c.plan,n===0)[7]!;if(previous){const d=Math.hypot(p.x-previous.x,p.z-previous.z);if(d<1e-10)zero++;max=Math.max(max,d);}previous={x:p.x,z:p.z};end=previous;}frames.push({hz,frames:hz*2,zeroMotionFrames:zero,maxTravelPerFrame:max,end});}
const report={kind:'axiom-town-crowd-measurement',seed:73129,runtime:process.version,scope:'CPU and geometry measurements only on this Node22 host. No FPS estimate, renderer/GPU frame-time, browser/mobile/device certification. 10Hz/2Hz activity selection remains; visible instanced transforms update every actual render callback.',cases,frames};const output=process.argv.find(a=>a.endsWith('.json'));if(output)writeFileSync(output,JSON.stringify(report,null,2)+'\n');console.log(JSON.stringify(report));
