const root=resolve(import.meta.dirname,'..'),assets=resolve(root,'dist/client/assets'),files=readdirSync(assets),dialogue=files.find(f=>/^npc-dialogue-.*\.js$/.test(f));assert(dialogue,'production dialogue chunk is emitted');const module=await import(pathToFileURL(resolve(assets,dialogue)).href),engine=Object.values(module).find((v:any)=>v?.kind==='axiom-npc-dialogue') as typeof CONVERSATION_ENGINE;assert(engine?.open&&engine?.choose&&engine?.view,'actual game API is exported');
