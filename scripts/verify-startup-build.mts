async function physics(file:string){const worker=new Worker(`const {parentPort}=require('node:worker_threads');globalThis.self=globalThis;self.postMessage=m=>parentPort.postMessage(m);globalThis.setInterval=fn=>globalThis.tick=fn;parentPort.on('message',async m=>{if(m.type==='advance'){for(let i=0;i<m.ticks;i++)globalThis.tick();parentPort.postMessage({type:'advanced'})}else await self.onmessage({data:m})});import(${JSON.stringify(pathToFileURL(file).href)}).then(()=>parentPort.postMessage({type:'boot'}));`,{eval:true,execArgv:['--experimental-strip-types']});const q:any[]=[],snapshots:any[]=[];let error:Error|undefined,epoch=0;worker.on('error',e=>error=e);worker.on('message',m=>{q.push(m);if(m.type==='snapshot')snapshots.push(m);if(m.type==='error')error=Error(m.message);});async function take(type:string){const end=Date.now()+20000;for(;;){if(error)throw error;const i=q.findIndex(m=>m.type===type);if(i>=0)return q.splice(i,1)[0];assert(Date.now()<end,'Timed out '+type);await new Promise(r=>setTimeout(r,2));}}const send=(m:Record<string,unknown>)=>worker.postMessage({epoch,...m});try{await take('boot');send({type:'init',x:0,z:0,obstacles:[],startPaused:true});await take('ready');send({type:'advance',ticks:120});await take('advanced');assert(snapshots.every(s=>s.step===0&&s.x===0));send({type:'teleport',x:2,z:2});send({type:'advance',ticks:60});await take('advanced');assert(snapshots.every(s=>s.step===0));const paused=snapshots.length;send({type:'input',x:1,z:0,analog:true,paused:false});send({type:'advance',ticks:90});await take('advanced');assert.equal(snapshots.at(-1).step,90);assert(snapshots.at(-1).x>2);const startup=snapshots.map(({step,x,z,feetY,vx,vy,vz,grounded,crouched,stance,sliding})=>({step,x,z,feetY,vx,vy,vz,grounded,crouched,stance,sliding}));const regression=[];for(const [sandbox,speedScale,jumpSpeed,gravity] of [[true,.5,4,28],[true,1.5,9,12],[false,1.5,9,12]]){epoch++;send({type:'zone',x:0,z:0,obstacles:[],bound:100,sandbox});await take('ready');send({type:'tuning',value:{speedScale,jumpSpeed,gravity}});if(sandbox)await take('tuning-ack');send({type:'input',x:1,z:0,analog:true,jump:true});const i=snapshots.length;send({type:'advance',ticks:90});await take('advanced');regression.push(snapshots.slice(i).map(({step,x,z,feetY,vx,vy,vz,grounded,crouched,stance,sliding})=>({step,x,z,feetY,vx,vy,vz,grounded,crouched,stance,sliding})));}return {startup,paused,regression};}finally{await worker.terminate();}}
