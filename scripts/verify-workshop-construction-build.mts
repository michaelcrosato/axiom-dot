 async function travel(target:{x:number;z:number}){for(let i=0;i<300;i++){const dx=target.x-latest.x,dz=target.z-latest.z,d=Math.hypot(dx,dz);if(d<.13){await tick(8);assert(Math.hypot(target.x-latest.x,target.z-latest.z)<.35);assert(Math.abs(latest.feetY-6)<.25);return;}await tick(1,dx/d,dz/d);}throw Error(`Worker route blocked ${JSON.stringify({target,latest})}`);}
