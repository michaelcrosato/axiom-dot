  for(const route of compiled.routes){for(const p of route.points)await travel(p);routes.push(`${rearRooms}/${route.key}`);for(const p of [...route.points].reverse())await travel(p);}
  const overlap={featureId:'probe-overlap',x:latest.x,y:7,z:latest.z,hx:1,hy:1,hz:1};b.send({type:'cell-load',epoch,key:'campaign-workshop',revision:2,obstacles:[...obstacles,overlap]});const rejected=await b.take('cell-rejected');assert.equal(rejected.reason,'player-overlap');assert.equal(rejected.loaded,true);b.send({type:'cell-load',epoch,key:'campaign-workshop',revision:3,obstacles});const ack=await b.take('cell-ack',m=>m.revision===3);assert.equal(ack.loaded,true);
  epoch++;b.send({type:'zone',epoch,x:parameters.width/2+2,z:0,y:6,streamedTerrain:true,obstacles:[],initialCells:[ground,{key:'campaign-workshop',revision:1,obstacles}],bound:48,sandbox:true,manual:true});await b.take('ready');await tick(120,-1,0);assert(latest.x>parameters.width/2+.2,'solid east wall stops actual capsule');assert(latest.x<parameters.width/2+1);epoch++;
