async function bridge(file:string){const worker=new Worker(`const{parentPort}=require('node:worker_threads');globalThis.self=globalThis;self.postMessage=m=>parentPort.postMessage(m);parentPort.on('message',m=>self.onmessage({data:m}));import(${JSON.stringify(pathToFileURL(file).href)}).then(()=>parentPort.postMessage({type:'boot'}));`,{eval:true,execArgv:['--experimental-strip-types']});const messages:any[]=[];let error:Error|undefined;worker.on('message',m=>{messages.push(m);if(m.type==='error')error=Error(m.message);});worker.on('error',e=>error=e);async function take(type:string,match:(m:any)=>boolean=()=>true){const until=Date.now()+20000;for(;;){if(error)throw error;const i=messages.findIndex(m=>m.type===type&&match(m));if(i>=0)return messages.splice(i,1)[0];assert(Date.now()<until,`worker deadline ${type}: ${JSON.stringify(messages.filter(m=>m.type!=='snapshot').slice(-5))}`);await new Promise(r=>setTimeout(r,2));}}await take('boot');return {worker,messages,take,send:(m:unknown)=>worker.postMessage(m)};}
